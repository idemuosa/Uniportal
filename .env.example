# =================================================================
# 💻 FRONTEND ENVIRONMENT VARIABLES (.env)
# =================================================================

# 1. Frontend API Configuration (HTTP / REST API Base URL)
# Points to the Node.js or Django API server
VITE_API_URL=http://localhost:5000

# 2. Frontend Socket Configuration (Real-time Socket.io / WebSocket URL)
# Points to the Real-time Socket.io server (defaults to VITE_API_URL if omitted)
VITE_SOCKET_URL=http://localhost:5000

# 3. Frontend Admin Routing Security
VITE_ADMIN_PATH=lukke-core-admin-002

# 4. Frontend Identity & Authentication (Firebase Web SDK)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional Client AI Key
GEMINI_API_KEY=your_gemini_api_key


# =================================================================
# 🌐 BACKEND ENVIRONMENT VARIABLES (.env)
# =================================================================

# --- A. NODE.JS BACKEND & SOCKET.IO SERVER (server.js / database.cjs) ---
# Server & Real-time Socket Port
PORT=5000

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/schoolportal

# Backend Authentication & AI Credentials
SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
GOOGLE_AI_KEY=your_gemini_api_key

# Institutional Mailer Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
ADMIN_EMAIL=admin@university.edu

# --- B. DJANGO REST API BACKEND (backend/server/settings.py) ---
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
