# =================================================================
# 🌐 NODE.JS BACKEND & SOCKET.IO CONFIGURATION (server.js / database.cjs / websocket_server.js)
# =================================================================
PORT=5000
WS_PORT=8080
CORS_ORIGIN=*
DATABASE_URL=postgres://user:password@localhost:5432/schoolportal
SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
GOOGLE_AI_KEY=your_gemini_api_key
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
ADMIN_EMAIL=admin@university.edu

# =================================================================
# 🐍 DJANGO API BACKEND CONFIGURATION (backend/server/settings.py)
# =================================================================
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =================================================================
# 💻 FRONTEND CONFIGURATION (React / Vite)
# =================================================================
# API & Socket Server URLs used by Axios & Socket.io client
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Firebase Auth & Web SDK configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Admin Security Path Configuration
VITE_ADMIN_PATH=lukke-core-admin-002

# Optional Gemini API key if loaded directly by Vite
GEMINI_API_KEY=your_gemini_api_key
